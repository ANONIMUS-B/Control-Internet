APP_NAME=Conformidad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_AZURE_DEFAULT_DOMAIN
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LARAVEL_STORAGE_PATH=/home/conformidad-storage
INERTIA_SSR_ENABLED=false

# Use an EXISTING MySQL database. Never run migrations as part of deployment.
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_EXISTING_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_EXISTING_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_EXISTING_DATABASE_USER
DB_PASSWORD=
# Set to the absolute CA certificate path when your database requires it.
# MYSQL_ATTR_SSL_CA=/home/certificates/database-ca.pem

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Conformidad

# This workflow uploads prebuilt files; Azure must not rebuild or mount a read-only ZIP.
SCM_DO_BUILD_DURING_DEPLOYMENT=false
WEBSITE_RUN_FROM_PACKAGE=0
